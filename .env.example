# ===== SIH v0.1 — Environment Configuration =====
# Copy this file to .env and adjust values for your machine.

# --- Camera ---
CAMERA_INDEX_1=0
CAMERA_INDEX_2=1
# Set to "true" to enable second camera, "false" for single-camera mode
ENABLE_CAMERA_2=false
# Target processing FPS (frames sampled from webcam for inference)
TARGET_FPS=4
# Camera resolution (width x height)
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# --- Object Detection ---
# "hsv" for HSV color+contour fallback (zero setup), "yolo" for YOLO fine-tuned model
DETECTOR_MODE=hsv
# Path to fine-tuned YOLO weights (only used if DETECTOR_MODE=yolo)
YOLO_WEIGHTS_PATH=models/yolo_finetuned.pt
# YOLO confidence threshold
YOLO_CONF_THRESHOLD=0.5

# --- Pose Estimation ---
# "mediapipe" for MediaPipe (zero setup), "rtmlib" for RTMPose via rtmlib
POSE_MODE=mediapipe

# --- TTS ---
# "pyttsx3" for system TTS (zero setup), "kokoro" for Kokoro-82M ONNX
TTS_ENGINE=pyttsx3
# Kokoro model path (only used if TTS_ENGINE=kokoro)
KOKORO_MODEL_PATH=models/kokoro-v0_19.onnx
KOKORO_VOICES_PATH=models/voices.bin

# --- STT (optional) ---
# "off" to disable, "faster_whisper" to enable
STT_ENGINE=off
# Whisper model size: tiny, base, small, medium, large-v3-turbo
STT_MODEL_SIZE=small

# --- Local LLM Assistant (optional) ---
# "off" to disable, "ollama" to use Ollama, "keyword" for simple keyword search
ASSISTANT_MODE=keyword
# Ollama model name (only used if ASSISTANT_MODE=ollama)
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_0

# --- Video Streaming ---
# Enable MJPEG network streaming
ENABLE_STREAM=true
# IP and port to serve MJPEG stream on
STREAM_HOST=0.0.0.0
STREAM_PORT=8554

# --- Video Storage ---
# Always save session video locally
SAVE_VIDEO=true
VIDEO_OUTPUT_DIR=data/videos

# --- Logging ---
LOG_OUTPUT_DIR=logs

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
